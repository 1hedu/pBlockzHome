[configuration]
entry_symbol = "pulseblockz_luau_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64   = "res://bin/libpulseblockz_luau.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libpulseblockz_luau.linux.template_release.x86_64.so"
windows.debug.x86_64   = "res://bin/libpulseblockz_luau.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libpulseblockz_luau.windows.template_release.x86_64.dll"
macos.debug   = "res://bin/libpulseblockz_luau.macos.template_debug.framework"
macos.release = "res://bin/libpulseblockz_luau.macos.template_release.framework"
