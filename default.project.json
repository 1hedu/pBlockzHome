{
  "name": "town",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": { "$className": "ReplicatedStorage", "$path": "src/shared" },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 15.5,
        "Brightness": 2,
        "Ambient": [0.35, 0.35, 0.4],
        "OutdoorAmbient": [0.45, 0.45, 0.5]
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.45,
          "Threshold": 1.3,
          "Size": 32
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ServerScriptService": { "$path": "src/server" },
    "StarterPlayer": {
      "$properties": {
        "DevComputerMovementMode": "Scriptable",
        "EnableMouseLockOption": false,
        "CharacterUseJumpPower": true
      },
      "StarterPlayerScripts": { "$path": "src/client" },
      "StarterCharacter": { "$path": "src/character/StarterCharacter.model.json" }
    },
    "Workspace": {
      "Map": { "$path": "src/map" }
    }
  }
}
